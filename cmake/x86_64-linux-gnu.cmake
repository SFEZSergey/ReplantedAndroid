# PVZ_ROOT: корень репозитория (по умолчанию — каталог выше этого файла).
if(NOT DEFINED PVZ_ROOT)
  get_filename_component(PVZ_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
# PVZ_SYSROOT_X86_64: x86-64 sysroot (Debian/Ubuntu libc6-dev, libstdc++-dev и др.).
if(NOT DEFINED PVZ_SYSROOT_X86_64)
  set(PVZ_SYSROOT_X86_64 "$ENV{PVZ_SYSROOT_X86_64}")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSROOT ${PVZ_SYSROOT_X86_64})
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_OBJCOPY llvm-objcopy)
set(CMAKE_STRIP llvm-strip)
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${PVZ_SYSROOT_X86_64}/usr -rtlib=libgcc -unwindlib=libgcc")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${PVZ_SYSROOT_X86_64}/usr -stdlib=libstdc++ -rtlib=libgcc -unwindlib=libgcc")
set(CMAKE_CROSSCOMPILING_EMULATOR ${PVZ_ROOT}/cmake/box64-emu.sh)
set(CMAKE_FIND_ROOT_PATH ${PVZ_SYSROOT_X86_64})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_LIBDIR} "${PVZ_SYSROOT_X86_64}/usr/lib/x86_64-linux-gnu/pkgconfig:${PVZ_SYSROOT_X86_64}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${PVZ_SYSROOT_X86_64}")
