+    // APS5_HOST_NAN=1: a NaN result keeps the host's NaN instead of the guest's quieted source or
+    // default NaN (only the payload bits differ; every NaN stays a NaN).
+    if (HostNanPropagation()) return result;
     const auto isNan = [&](IrValue& bits) -> IrValue& { return ir.UGreaterThan(ir.BitwiseAnd(bits, ir.Constant(0x7fffffffu)), ir.Constant(0x7f800000u)); };
