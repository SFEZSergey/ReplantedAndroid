+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetMemoryHostPointerPropertiesEXT(
+   VkDevice _device,
+   VkExternalMemoryHandleTypeFlagBits handleType,
+   const void *pHostPointer,
+   VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+
+   if (handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       ((uintptr_t) pHostPointer & (os_page_size - 1)))
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   /* Imported user pages are CPU-cached: offer the cached coherent types
+    * (the GPU snoops the CPU caches), else the cached non-coherent ones.
+    */
+   const struct tu_physical_device *pdevice = device->physical_device;
+   const VkMemoryPropertyFlags coherent =
+      VK_MEMORY_PROPERTY_HOST_CACHED_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t coherent_bits = 0, cached_bits = 0;
+   for (uint32_t i = 0; i < pdevice->memory.non_lazy_type_count; i++) {
+      if ((pdevice->memory.types[i] & coherent) == coherent)
+         coherent_bits |= 1u << i;
+      else if (pdevice->memory.types[i] & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)
+         cached_bits |= 1u << i;
+   }
+   pMemoryHostPointerProperties->memoryTypeBits =
+      coherent_bits ? coherent_bits : cached_bits;
+   return VK_SUCCESS;
+}
