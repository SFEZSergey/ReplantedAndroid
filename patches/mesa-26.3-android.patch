diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 5580ed8..3b5629a 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -448,6 +448,77 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    return VK_SUCCESS;
 }
 
+/* VK_EXT_external_memory_host: KGSL pins the user pages and maps them into
+ * the GPU address space (KGSL_USER_MEM_TYPE_ADDR).
+ */
+static VkResult
+kgsl_bo_init_userptr(struct tu_device *dev,
+                     struct tu_bo **out_bo,
+                     uint64_t size,
+                     VkMemoryPropertyFlags mem_property,
+                     void *host_ptr)
+{
+   struct kgsl_gpuobj_import_useraddr import_useraddr = {
+      .virtaddr = (uintptr_t) host_ptr,
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = (uintptr_t)&import_useraddr,
+      .priv_len = size,
+      .flags = 0,
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+
+   if ((mem_property & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) &&
+       (mem_property & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+      req.flags |= KGSL_MEMFLAGS_IOCOHERENT;
+   req.flags |= KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT;
+
+   int ret = safe_ioctl(dev->physical_device->local_fd,
+                        IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   if (ret && errno == EFAULT) {
+      /* Read-only pages can only be pinned for GPU reads. */
+      req.flags |= KGSL_MEMFLAGS_GPUREADONLY;
+      ret = safe_ioctl(dev->physical_device->local_fd,
+                       IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   }
+   if (ret)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import host pointer %p+0x%" PRIx64 " (%s)",
+                       host_ptr, size, strerror(errno));
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_INFO, &info_req);
+   if (ret) {
+      struct kgsl_gpumem_free_id free_req = { .id = req.id };
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Failed to get host pointer import info (%s)",
+                       strerror(errno));
+   }
+
+   struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = info_req.size,
+      .iova = info_req.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, info_req.size, "host pointer"),
+      .refcnt = 1,
+      .shared_fd = -1,
+   };
+   bo->host_ptr = true;
+
+   tu_dump_bo_init(dev, bo);
+
+   *out_bo = bo;
+   return VK_SUCCESS;
+}
+
 static int
