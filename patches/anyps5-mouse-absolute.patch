+    if (data == nullptr || num <= 0 || num > MOUSE_MAX_DATA_NUM) return MOUSE_ERROR_INVALID_ARG;
+    // The current state as one sample (the cursor has no history to replay).
+    MouseAbsoluteData sample{};
