+    sample.x = static_cast<std::uint16_t>(absoluteX);
+    sample.y = static_cast<std::uint16_t>(absoluteY);
+    sample.wheel = std::exchange(absoluteWheel, 0);
+    sample.tilt = std::exchange(absoluteTilt, 0);
