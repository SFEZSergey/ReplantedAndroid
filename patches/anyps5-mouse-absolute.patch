+// Absolute-position mode (PS5). The handle comes first as in the rest of the library; the other parameters are
+// not verified on a console (docs/dev/TechnicalDebt.md). The settings change nothing: the host input layer reports
+// relative motion only, so no absolute sample is ever produced.
+int APS5_VABI sceMouseSetAbsoluteVirtualScreenSize(std::int32_t handle, std::int32_t width, std::int32_t height) {
+    (void)width;
+    (void)height;
+    return Mouse::CheckHandle(handle);
+}
+
+int APS5_VABI sceMouseResetAbsolutePosition(std::int32_t handle) {
+    return Mouse::CheckHandle(handle);
+}
+
+int APS5_VABI sceMouseSetAbsoluteHighPrecisionMode(std::int32_t handle, bool enabled) {
+    (void)enabled;
+    return Mouse::CheckHandle(handle);
+}
+
+// Nothing is written to the caller's buffer: no new position, as with a mouse that has not moved.
+int APS5_VABI sceMouseReadAbsolutePosition(std::int32_t handle, void* data, std::int32_t num) {
+    (void)data;
+    (void)num;
+    return Mouse::CheckHandle(handle);
+}
+
 void MousePublishInput_nid_postfix(const MouseInputEvent& event) {
     Mouse::Publish(event);
 }
