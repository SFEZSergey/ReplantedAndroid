+// APS5_PROFILE_GPU: the [gputime] key of a draw's own range beside its class range: the render
+// extent, the color target count and the fragment program's variant, so the report splits the
+// draw time by pass (Recorder::readGpuTiming decodes it). Each new key is described once.
+std::uint64_t passTimingKey(const State& state, std::span<const CompiledShader> shaders) {
+    std::uint64_t fragment = 0;
+    for (const auto& shader : shaders) {
+        if (shader.stage == ShaderRecompiler::ShaderStage::Fragment && shader.program != nullptr) fragment = shader.program->PipelineVariantId();
+    }
+    const auto clamp = [](std::uint64_t value, std::uint64_t limit) { return std::min(value, limit); };
+    const auto key = Recorder::PassTimingBit | clamp(state.renderExtent.width, 0x3fff) << 44 | clamp(state.renderExtent.height, 0x3fff) << 30 | clamp(state.colors.size(), 7) << 27 | (fragment & 0x7ffffff);
+    static std::mutex mutex;
+    static std::set<std::uint64_t> described;
+    std::lock_guard lock(mutex);
+    if (described.size() < 256 && described.insert(key).second) {
+        std::string formats;
+        for (const auto& color : state.colors) formats += " " + std::to_string(static_cast<int>(color.format)) + "@" + std::to_string(color.extent.width) + "x" + std::to_string(color.extent.height);
+        std::fprintf(stderr, "[gputime] pass %llx: render %ux%u, colors%s, depth %s, fragment variant %llx\n", static_cast<unsigned long long>(key), state.renderExtent.width, state.renderExtent.height, formats.empty() ? " none" : formats.c_str(), state.depth ? (std::to_string(static_cast<int>(state.depth->format)) + "@" + std::to_string(state.depth->extent.width) + "x" + std::to_string(state.depth->extent.height)).c_str() : "none", static_cast<unsigned long long>(fragment));
+    }
+    return key;
+}
